{
  "name": "@coredoc/desktop",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "description": "Coredoc Desktop Application",
  "private": true,
  "main": "dist/main/index.js",
  "type": "module",
  "author": "coredoc team",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:electron": "electron-vite dev",
    "test": "vitest run",
    "design:check": "node scripts/design-conformance.mjs",
    "e2e": "pnpm run build && playwright test --config e2e/playwright.config.ts",
    "e2e:only": "playwright test --config e2e/playwright.config.ts",
    "build": "pnpm --filter @coredoc/core build && pnpm --filter @coredoc/db build && pnpm --filter @coredoc/mcp build && pnpm --filter @coredoc/profile-parser build && pnpm --filter @coredoc/cli build && node ./scripts/copy-runtime-bundles.mjs && electron-vite build",
    "build:app": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "preview": "electron-vite preview",
    "electron": "electron .",
    "clean": "rm -rf dist dist-electron",
    "build:mac": "pnpm run build && pnpm run smoke && electron-builder --mac --config.directories.output=dist-electron/mac && COREDOC_SMOKE_DIST_ELECTRON=dist-electron/mac pnpm run smoke:post",
    "build:win": "electron-builder --win --config.directories.output=dist-electron/win",
    "build:linux": "electron-builder --linux --config.directories.output=dist-electron/linux",
    "postinstall": "electron-builder install-app-deps",
    "smoke": "node ./scripts/smoke-packaged-runtime.mjs --pre",
    "smoke:post": "node ./scripts/smoke-packaged-runtime.mjs --post",
    "clean:unpacked": "node ./scripts/clean-unpacked.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.77",
    "@ladybugdb/core": "0.19.1",
    "@libsql/client": "^0.14.0",
    "@tanstack/react-query": "^5.101.2",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "electron-updater": "^6.8.3",
    "posthog-js": "^1.364.7",
    "react-virtuoso": "^4.18.4",
    "stream-chain": "^3.4.0",
    "typescript": "^5.3.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@coredoc/cli": "workspace:*",
    "@coredoc/core": "workspace:*",
    "@coredoc/db": "workspace:*",
    "@coredoc/mcp": "workspace:*",
    "@coredoc/profile-parser": "workspace:*",
    "@figma/code-connect": "^1.5.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@playwright/test": "1.62.1",
    "@solar-icons/react": "^1.1.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/stream-json": "^1.7.8",
    "@vitejs/plugin-react": "^4.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.3.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "happy-dom": "^16.3.2",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.4.0",
    "radix-ui": "^1.4.3",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.22.0",
    "react-syntax-highlighter": "^15.6.1",
    "react-zoom-pan-pinch": "^3.6.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "shadcn": "^3.8.4",
    "stream-json": "^1.9.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^5.1.0",
    "vitest": "^1.3.0",
    "yaml": "^2.8.2",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "com.coredoc.desktop",
    "productName": "Coredoc",
    "publish": {
      "provider": "github",
      "owner": "yvp-core",
      "repo": "coredoc-platform"
    },
    "icon": "resources/icons/icon",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      {
        "from": "dist/runtime",
        "to": "dist/runtime",
        "filter": [
          "_vendor/@coredoc/**/*.d.ts",
          "packages/**/*.d.ts",
          "_vendor/typescript/lib/*.d.ts"
        ]
      }
    ],
    "asarUnpack": [
      "dist/runtime/**",
      "node_modules/@ladybugdb/**",
      "node_modules/@anthropic-ai/claude-agent-sdk/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "afterPack": "./scripts/after-pack.mjs",
    "protocols": {
      "name": "Coredoc Auth",
      "schemes": [
        "coredoc"
      ]
    }
  }
}
