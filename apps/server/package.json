{
  "name": "@coredoc/server",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "description": "NestJS server for coredoc team collaboration",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "test": "vitest run",
    "test:postgres": "bash scripts/test-postgres-integration.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1015.0",
    "@aws-sdk/s3-request-presigner": "^3.1020.0",
    "@coredoc/core": "workspace:*",
    "@coredoc/db": "workspace:*",
    "@coredoc/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@rekog/mcp-nest": "^1.9.0",
    "cookie-parser": "^1.4.7",
    "jose": "^6.0.0",
    "passport": "^0.7.0",
    "passport-github": "^1.1.0",
    "passport-oauth2": "^1.8.0",
    "pg": "^8.19.0",
    "posthog-node": "^5.28.11",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "tar": "^7.5.20",
    "yaml": "^2.8.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.15.24",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-github": "^1.1.12",
    "@types/passport-oauth2": "^1.8.0",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "prisma": "^7.4.2",
    "supertest": "^7.2.2",
    "typescript": ">=5.0.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ]
}
