# Self-hosted OAuth — upstream identity provider selection.
# OAUTH_UPSTREAM=github (default) | workos
# OAUTH_UPSTREAM=github

# --- GitHub upstream (default) ---
# Create a GitHub OAuth App (Settings > Developer settings > OAuth Apps).
# Authorization callback URL: <MCP_SERVER_URL>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- WorkOS upstream (OAUTH_UPSTREAM=workos) ---
# Uses AuthKit as an OIDC provider (WorkOS Connect). Create a Connect
# Application in the WorkOS dashboard with redirect URI <MCP_SERVER_URL>/callback,
# then set the AuthKit domain and the application's client credentials.
# With WorkOS the AuthKit tenant config (auth methods, SSO connections, domain
# policies) is the primary login gate; ALLOWED_EMAIL_DOMAINS becomes an
# OPTIONAL extra allowlist (may be left unset).
# WORKOS_CLIENT_ID / WORKOS_CLIENT_SECRET are the Connect OAuth Application's
# OWN credentials (Dashboard -> Connect -> OAuth Applications) — NOT the sk_...
# API key, and NOT the environment client id shown on the API Keys page. Feeding
# the API-Keys client id here yields "application_not_found" at /oauth2/authorize.
# WORKOS_AUTHKIT_DOMAIN=https://<subdomain>.authkit.app
# WORKOS_CLIENT_ID=client_...   # Connect OAuth Application client id
# WORKOS_CLIENT_SECRET=         # Connect OAuth Application secret (NOT the sk_... API key)
# WORKOS_AUTHKIT_CLIENT_ID=client_... # AuthKit Application client id that owns invitation emails
# WORKOS_API_KEY=sk_...          # Server key from that AuthKit Application/environment
# Connect redirect: ${SERVER_URL}/callback
# AuthKit Application default redirect: ${SERVER_URL}/api/v1/auth/web/workos-invitation-callback

# Secret used to sign issued access tokens (must be >= 32 chars).
# Generate with: openssl rand -hex 32
OAUTH_JWT_SECRET=

# Public base URL of this server — used as the OAuth issuer + MCP resource.
# Do NOT change it to move the UI to another hostname: it is the `aud` of every
# MCP token already issued, so changing it forces every connected MCP client to
# re-authorize. Use WEB_ORIGINS below instead.
MCP_SERVER_URL=http://localhost:3000

# Optional: additional public base URLs the UI is served on (comma-separated),
# e.g. https://ai-dashboard.example.com. Each gets a registered web-login
# callback, so a login started on that host also completes there instead of
# landing back on MCP_SERVER_URL without a session. `/authorize` and the
# upstream IdP callback stay on MCP_SERVER_URL — no identity-provider change.
WEB_ORIGINS=

# Login gate — comma-separated, lowercase email domains.
# GitHub upstream: REQUIRED (an empty gate is a boot error). A user may sign
# in only if their VERIFIED GitHub email is in one of these.
# WorkOS upstream: OPTIONAL defense-in-depth (unset = rely on AuthKit tenant
# config); the verified-email requirement still always applies.
# Workspace access is gated separately by membership: seed the first admin in
# the DB, then invite the rest by email. With a non-WorkOS upstream, Coredoc
# creates pending access but sends no email; the UI returns a sign-in link for
# an admin to share manually.
ALLOWED_EMAIL_DOMAINS=coredoc.ai

# Issued token lifetimes (optional; defaults 1d / 30d)
# OAUTH_ACCESS_TTL=1d
# OAUTH_REFRESH_TTL=30d

# Encryption key for tokens at rest (32 bytes; hex or base64 both accepted)
# Generate with: openssl rand -hex 32   (or: openssl rand -base64 32)
SERVER_ENCRYPTION_KEY=

# Turso — team database provisioning (optional for local dev)
TURSO_ORG=
TURSO_ORG_TOKEN=

# Object storage — S3-compatible (optional, falls back to local filesystem in dev)
# Default: Cloudflare R2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=coredoc-parsers-dev
# R2_REGION=auto                  # signing region (default: auto)
# R2_FORCE_PATH_STYLE=false       # set "true" for path-style addressing
#
# Google Cloud Storage (S3 interoperability / XML API) — for self-hosted deployments.
# Use an HMAC key (Settings > Interoperability) as the access key / secret:
#   R2_ENDPOINT=https://storage.googleapis.com
#   R2_ACCESS_KEY_ID=<GCS HMAC access ID>
#   R2_SECRET_ACCESS_KEY=<GCS HMAC secret>
#   R2_BUCKET=<gcs-bucket-name>

DATABASE_URL=postgresql://coredoc:coredoc@postgres:5432/coredoc # for local dev

# Optional modules (default off)
# Source module: GET /workspaces/:id/source/:repo/<path>?ref=<git-ref> — fetches
# file content from the repo's git provider (GitHub/GitLab) for workspace members.
# Uses GITHUB_TOKEN / GITLAB_TOKEN from the environment for private repos.
# ENABLE_SOURCE_MODULE=true
# CLI bundle module: GET /cli/bundle?v=<version> — presigned download URLs for
# CLI bundles stored in object storage (built by scripts/build-cli-bundle.mjs,
# uploaded under cli-bundles/ with a manifest.json). Requires R2_* config.
# ENABLE_CLI_BUNDLE=true

# Desktop release bucket backing GET /api/v1/auth/web/desktop-download (the
# invitation handoff page's download buttons). Must serve the electron-builder
# `latest-mac.yml` manifest and the DMGs it names. Defaults to the hosted
# bucket; override to mirror the builds inside your own egress boundary.
# DESKTOP_RELEASES_URL=https://releases.example.com
