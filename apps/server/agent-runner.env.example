# Local agent runner for docker-compose.yml. Copy to agent-runner.env (ignored
# by git) and fill in. The full reference is docs/onprem/AGENT-RUNS.md.

# Workspace and runner token from Settings → Agent runs (the token is shown once).
COREDOC_WORKSPACE_ID=
COREDOC_RUNNER_TOKEN=

# The customer's own model key, from a workspace with a spend limit.
ANTHROPIC_API_KEY=
# Local development only, instead of ANTHROPIC_API_KEY: your own subscription token
# from `claude setup-token`. Honoured only by the docker-compose dev runner.
# CLAUDE_CODE_OAUTH_TOKEN=

# The bot account's GitHub token and commit identity.
COREDOC_GITHUB_TOKEN=
COREDOC_GIT_AUTHOR_NAME=
COREDOC_GIT_AUTHOR_EMAIL=

# Optional: scope → registry mapping, see docs/onprem/AGENT-RUNS.md.
# COREDOC_PACKAGE_REGISTRIES={"@example":{"url":"https://npm.pkg.github.com","credential":"github"}}
