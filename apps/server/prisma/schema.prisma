// Prisma schema for Coredoc control plane (PostgreSQL)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  slug                 String
  dbUrl                String?              @map("db_url")
  dbTokenEncrypted     String?              @map("db_token_encrypted")
  isCloud              Boolean              @default(false) @map("is_cloud")
  ciCdEnabled          Boolean              @default(false) @map("ci_cd_enabled")
  deliveryEnabled      Boolean              @default(false) @map("delivery_enabled")
  intentEnabled        Boolean              @default(false) @map("intent_enabled")
  // Who records intent release events for this workspace (amendment §2).
  // `manual` is today's behaviour and stays the default, so an existing
  // workspace gains no automatic actor on deploy.
  intentReleaseTrigger IntentReleaseTrigger @default(manual) @map("intent_release_trigger")
  graphBackend         String               @default("file_snapshot") @map("graph_backend") @db.VarChar(32)
  activeGraphVersionId String?              @map("active_graph_version_id") @db.VarChar(64)
  // Must default true alongside graphBackend = "file_snapshot": the
  // workspaces_file_snapshot_requires_retention_check constraint (migration
  // 20260811120000) rejects any file-snapshot row without retention.
  retainGraphArtifacts Boolean              @default(true) @map("retain_graph_artifacts")
  workosOrganizationId String?              @unique @map("workos_organization_id")
  syncedAt             DateTime?            @map("synced_at") @db.Timestamptz
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz

  members                   WorkspaceMember[]
  repos                     WorkspaceRepo[]
  tokens                    ServiceToken[]
  parserArtifacts           ParserArtifact[]
  mapperArtifact            MapperArtifact?
  pushMetrics               PushMetric[]
  mcpQueryMetrics           McpQueryMetric[]
  pushJobs                  PushJob[]
  repoPushLeases            RepoPushLease[]
  graphWriteLease           WorkspaceGraphWriteLease?
  graphVersions             WorkspaceGraphVersion[]    @relation("WorkspaceGraphVersions")
  activeGraphVersion        WorkspaceGraphVersion?     @relation("WorkspaceActiveGraphVersion", fields: [id, activeGraphVersionId], references: [workspaceId, versionId], onDelete: NoAction, onUpdate: NoAction)
  agentSessions             AgentSession[]
  captureEvents             CaptureEvent[]
  captureProvisioning       CaptureProvisioning[]
  captureAcceptedWatermarks CaptureAcceptedWatermark[]
  workflowRuns              WorkflowRun[]
  deliveryTasks             DeliveryTask[]
  deliveryArtifacts         DeliveryArtifact[]
  taskExternalRefStateFacts TaskExternalRefStateFact[]
  deliveryTaskCodeChanges   DeliveryTaskCodeChange[]
  deliveryShipEvidence      DeliveryShipEvidence[]
  deliveryReworkSignals     DeliveryReworkSignal[]
  mcpFeedback               McpFeedback[]
  desktopAgentRuns          DesktopAgentRun[]

  deliveryConnectors  DeliveryConnector[]
  codeChanges         CodeChange[]
  deliveryRawPayloads DeliveryRawPayload[]

  deliveryActors          DeliveryActor[]
  deliveryActorIdentities DeliveryActorIdentity[]
  deliveryStatusMaps      DeliveryStatusMap[]

  intentHandoffs         IntentHandoff[]
  intentDomains          IntentDomain[]
  intentDimensions       IntentDimension[]
  intentFeatures         IntentFeature[]
  intentItems            IntentItem[]
  intentReleaseEvents    IntentReleaseEvent[]
  intentNodeRelations    IntentNodeRelation[]
  intentComments         IntentComment[]
  intentAuditEvents      IntentAuditEvent[]
  intentMutationRequests IntentMutationRequest[]

  cloudAgentRuns         CloudAgentRun[]
  cloudAgentRunTurns     CloudAgentRunTurn[]
  cloudAgentRunEvents    CloudAgentRunEvent[]
  cloudAgentRunSpecs     CloudAgentRunSpecVersion[]
  cloudAgentRunQuestions CloudAgentRunQuestion[]
  agentRunSettings       AgentRunSettings?
  agentRunnersSeen       AgentRunnerSeen[]

  @@map("workspaces")
}

model WorkspaceGraphVersion {
  workspaceId          String   @map("workspace_id") @db.Uuid
  versionId            String   @map("version_id") @db.VarChar(64)
  engine               String   @db.VarChar(16)
  r2Key                String   @map("r2_key")
  sha256               String   @db.VarChar(64)
  sizeBytes            BigInt   @map("size_bytes")
  storageFormatVersion Int      @map("storage_format_version")
  manifest             Json     @db.JsonB
  parentVersionId      String?  @map("parent_version_id") @db.VarChar(64)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace           Workspace               @relation("WorkspaceGraphVersions", fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  activeForWorkspaces Workspace[]             @relation("WorkspaceActiveGraphVersion")
  parent              WorkspaceGraphVersion?  @relation("WorkspaceGraphVersionParent", fields: [workspaceId, parentVersionId], references: [workspaceId, versionId], onDelete: NoAction, onUpdate: NoAction)
  children            WorkspaceGraphVersion[] @relation("WorkspaceGraphVersionParent")

  @@id([workspaceId, versionId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, parentVersionId])
  @@map("workspace_graph_versions")
}

model WorkspaceMember {
  workspaceId String   @map("workspace_id") @db.Uuid
  // OAuth profile_id of the linked user. For invited-but-not-yet-logged-in
  // members this holds a placeholder until first login reconciles it (see
  // PrismaOAuthStore.upsertUserProfile + pending below).
  userId      String   @map("user_id")
  email       String
  displayName String?  @map("display_name")
  role        String   @default("member")
  // True while the member was invited by email but has not logged in yet. On
  // first login PrismaOAuthStore re-keys the row to the real userId (profile_id)
  // and clears this flag.
  pending     Boolean  @default(false)
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitation WorkspaceInvitation?

  @@id([workspaceId, userId])
  // One identity per workspace. Emails are normalized to lowercase on write
  // (see ControlPlaneService.addMember / createPendingMember), so this also
  // stops a pending invite and a real member diverging for the same person.
  @@unique([workspaceId, email])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  memberUserId       String    @map("member_user_id")
  workosInvitationId String?   @map("workos_invitation_id")
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz
  lastSentAt         DateTime? @map("last_sent_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  member WorkspaceMember @relation(fields: [workspaceId, memberUserId], references: [workspaceId, userId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workspaceId, memberUserId])
  @@index([workosInvitationId])
  @@map("workspace_invitations")
}

model WorkspaceRepo {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String                @map("workspace_id") @db.Uuid
  repoKey              String                @map("repo_key")
  repoName             String                @map("repo_name")
  gitUrl               String?               @map("git_url")
  repoType             String?               @map("repo_type")
  captureRepositoryKey String?               @map("capture_repository_key")
  // Durable repo identity that intent anchors and feature seeds address a
  // repository by (spec §6.5). `repoKey` above is the GRAPH identity; this is
  // the display-form key whose hash must provably reproduce it — enforced by
  // `workspace_repos_intent_repo_key_graph_hash_check` (migration
  // 20260901100000), so a key can never be bound to the wrong graph.
  intentRepoKey        String?               @map("intent_repo_key")
  // Credential-free, normalized git remote (normalizeGitRemote), shape-checked
  // by `workspace_repos_normalized_git_remote_check` in the same migration.
  normalizedGitRemote  String?               @map("normalized_git_remote") @db.VarChar(2048)
  // Per-repo URL prefix (e.g. '/v1/public/api-gateway'). Used by the cloud
  // cross-repo resolver to index entrypoints under both raw and prefix-stripped
  // paths so gateway-naive SDK callers match. Mirrors RepoConfig.httpPrefix
  // from the CLI's coredoc.config.json — populated when desktop calls
  // POST /workspaces/:id/repos.
  httpPrefix           String?               @map("http_prefix")
  // Branch a merge/deploy into counts as production for intent releases
  // (amendment §2). Null = the default branch the delivery connector reports.
  productionBranch     String?               @map("production_branch")
  // Null inherits the workspace default; overrides apply only to this repository.
  intentReleaseTrigger IntentReleaseTrigger? @map("intent_release_trigger")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz

  // Retained legacy transport data for rollback; no handoff runtime consumer.
  intentAnchorsCommit         String? @map("intent_anchors_commit") @db.VarChar(40)
  intentAnchorsGraphVersionId String? @map("intent_anchors_graph_version_id") @db.VarChar(128)

  // Push tracking
  lastParseHash      String?   @map("last_parse_hash")
  lastPushedAt       DateTime? @map("last_pushed_at") @db.Timestamptz
  lastPushedByUserId String?   @map("last_pushed_by_user_id")
  nodeCount          Int?      @map("node_count")
  edgeCount          Int?      @map("edge_count")

  // R2 versioned storage tracking
  lastParsedVersion  String? @map("last_parsed_version")
  lastSummaryVersion String? @map("last_summary_version")
  lastEmbedVersion   String? @map("last_embed_version")

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artifacts WorkspaceRepoArtifact[]

  @@unique([workspaceId, repoKey])
  @@unique([workspaceId, captureRepositoryKey])
  @@unique([workspaceId, intentRepoKey])
  @@map("workspace_repos")
}

enum WorkspaceRepoArtifactKind {
  parsed
  summary
  embeddings
}

model WorkspaceRepoArtifact {
  workspaceId String                    @map("workspace_id") @db.Uuid
  repoKey     String                    @map("repo_key")
  repoName    String                    @map("repo_name")
  kind        WorkspaceRepoArtifactKind
  version     String                    @db.VarChar(68)
  r2Key       String                    @map("r2_key")
  sha256      String                    @db.VarChar(64)
  sizeBytes   BigInt                    @map("size_bytes")
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz

  repository WorkspaceRepo @relation(fields: [workspaceId, repoKey], references: [workspaceId, repoKey], onDelete: Cascade, onUpdate: Cascade)

  @@id([workspaceId, repoKey, kind, version])
  @@index([workspaceId, repoName, kind, version])
  @@map("workspace_repo_artifacts")
}

model ServiceToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  name           String
  tokenHash      String    @map("token_hash")
  tokenEncrypted String?   @map("token_encrypted")
  tokenPrefix    String?   @map("token_prefix") @db.VarChar(12)
  permissions    String[]  @default([])
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz
  /// Set only on a cloud agent run's per-turn MCP token: MCP-only, hash-only,
  /// hidden from the token list, deleted with its turn.
  owningTurnId   String?   @map("owning_turn_id") @db.Uuid

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owningTurn   CloudAgentRunTurn?  @relation("ServiceTokenOwningTurn", fields: [workspaceId, owningTurnId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction)
  claimedTurns CloudAgentRunTurn[] @relation("CloudAgentRunTurnClaimedBy")
  runnerSeen   AgentRunnerSeen?

  @@unique([workspaceId, name])
  @@index([owningTurnId])
  @@map("service_tokens")
}

model ParserArtifact {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  repoName    String   @map("repo_name")
  r2Key       String   @map("r2_key")
  sizeBytes   Int      @map("size_bytes")
  sha256      String   @map("sha256")
  uploadedBy  String   @map("uploaded_by")
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz
  metadata    Json?    @map("metadata")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, repoName])
  @@map("parser_artifacts")
}

model MapperArtifact {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @unique @map("workspace_id") @db.Uuid
  r2Key       String   @map("r2_key")
  sizeBytes   Int      @map("size_bytes")
  sha256      String   @map("sha256")
  uploadedBy  String   @map("uploaded_by")
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz
  metadata    Json?    @map("metadata")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("mapper_artifacts")
}

model PushMetric {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String  @map("workspace_id") @db.Uuid
  repoKey        String  @map("repo_key")
  repoName       String  @map("repo_name")
  executionToken String? @unique @map("execution_token") @db.Uuid

  // Push context
  commitHash     String?  @map("commit_hash")
  pushedByUserId String?  @map("pushed_by_user_id")
  pushMode       String   @map("push_mode") // 'incremental' | 'full'
  pushedAt       DateTime @default(now()) @map("pushed_at") @db.Timestamptz

  // Push performance
  pushDurationMs Int?   @map("push_duration_ms")
  diffSkippedPct Float? @map("diff_skipped_pct")

  // Graph snapshot
  totalNodes  Int  @map("total_nodes")
  totalEdges  Int  @map("total_edges")
  nodesByType Json @map("nodes_by_type") // { function: 120, class: 30, ... }
  edgesByType Json @map("edges_by_type") // { CALLS: 500, IMPORTS: 200, ... }

  // Derived counts
  entrypointCount   Int @default(0) @map("entrypoint_count")
  entityCount       Int @default(0) @map("entity_count")
  externalCallCount Int @default(0) @map("external_call_count")
  componentCount    Int @default(0) @map("component_count")

  // Change delta (compared to previous push, null for first push)
  nodesAdded   Int? @map("nodes_added")
  nodesUpdated Int? @map("nodes_updated")
  nodesDeleted Int? @map("nodes_deleted")

  // Documentation coverage
  nodesWithSummaries  Int @default(0) @map("nodes_with_summaries")
  nodesWithEmbeddings Int @default(0) @map("nodes_with_embeddings")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, repoKey])
  @@index([workspaceId, pushedAt])
  @@index([repoKey, pushedAt])
  @@map("push_metrics")
}

model McpQueryMetric {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  toolName    String   @map("tool_name")
  userId      String?  @map("user_id")
  durationMs  Int      @map("duration_ms")
  success     Boolean  @default(true)
  // Retrieval-quality parity with the local SQLite `mcp_queries` table: number
  // of items a list-shaped tool produced (0 for a single-entity miss), null
  // for tools/response shapes the classifier can't establish a count for.
  // Nullable — old rows and unclassified tools never joined a value, and
  // `getMcpEmptyResultBreakdown` excludes NULL rows from both its numerator
  // and denominator rather than treating them as non-empty or empty.
  resultCount Int?     @map("result_count")
  // Workspace repo scope the tool resolved for the call (vantage or explicit
  // `scope` arg), when one was resolved. Null when the call was unscoped
  // (whole-workspace) or scope resolution failed before the handler ran.
  scope       String?
  queriedAt   DateTime @default(now()) @map("queried_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, queriedAt])
  @@index([workspaceId, toolName])
  // Global date-only sweep for the retention cron: the composite index above
  // is workspace-first and cannot serve `WHERE queried_at < cutoff` across all
  // workspaces without a full scan.
  @@index([queriedAt])
  @@map("mcp_query_metrics")
}

model SyncState {
  key       String   @id @map("key")
  value     String   @map("value")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("sync_state")
}

// ===========================================================================
// Self-hosted OAuth 2.1 authorization server (@rekog/mcp-nest custom store).
// Field names mirror the IOAuthStore interface so PrismaOAuthStore maps 1:1.
// expires_at / expiresAt are BigInt millisecond epochs (per the SDK contract).
// ===========================================================================

model OAuthClient {
  client_id                  String   @id
  client_secret              String?
  client_name                String
  client_description         String?
  logo_uri                   String?
  client_uri                 String?
  developer_name             String?
  developer_email            String?
  redirect_uris              String[]
  grant_types                String[]
  response_types             String[]
  token_endpoint_auth_method String
  created_at                 DateTime @default(now()) @db.Timestamptz
  updated_at                 DateTime @updatedAt @db.Timestamptz

  @@map("oauth_clients")
}

model AuthorizationCode {
  code                  String    @id
  user_id               String
  client_id             String
  redirect_uri          String
  code_challenge        String
  code_challenge_method String
  expires_at            BigInt
  resource              String?
  scope                 String?
  used_at               DateTime? @db.Timestamptz
  user_profile_id       String?
  created_at            DateTime  @default(now()) @db.Timestamptz

  @@map("oauth_authorization_codes")
}

model OAuthSession {
  sessionId           String   @id
  state               String
  clientId            String?
  redirectUri         String?
  codeChallenge       String?
  codeChallengeMethod String?
  oauthState          String?
  resource            String?
  scope               String?
  expiresAt           BigInt
  created_at          DateTime @default(now()) @db.Timestamptz

  @@map("oauth_sessions")
}

model OAuthUserProfile {
  profile_id       String   @id
  provider_user_id String
  provider         String
  username         String
  email            String?
  displayName      String?
  avatarUrl        String?
  raw              String?
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @updatedAt @db.Timestamptz

  @@index([provider_user_id])
  @@map("oauth_user_profiles")
}

model AgentSession {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  provider    String  @default("claude-code") @db.VarChar(32)
  sessionId   String  @map("session_id")
  userId      String? @map("user_id")
  userEmail   String? @map("user_email")
  model       String?
  appVersion  String? @map("app_version")

  tokensInput         BigInt @default(0) @map("tokens_input")
  tokensOutput        BigInt @default(0) @map("tokens_output")
  tokensCacheRead     BigInt @default(0) @map("tokens_cache_read")
  tokensCacheCreation BigInt @default(0) @map("tokens_cache_creation")
  tokensReasoning     BigInt @default(0) @map("tokens_reasoning")
  costUsd             Float  @default(0) @map("cost_usd")
  activeTimeSec       Float  @default(0) @map("active_time_sec")
  commitCount         Int    @default(0) @map("commit_count")
  prCount             Int    @default(0) @map("pr_count")
  coredocToolCalls    Int    @default(0) @map("coredoc_tool_calls")
  coredocTools        Json   @default("{}") @map("coredoc_tools")

  locAdded         Int  @default(0) @map("loc_added")
  locRemoved       Int  @default(0) @map("loc_removed")
  coredocToolStats Json @default("{}") @map("coredoc_tool_stats")

  // Task/PR join keys (v2 spec §3 Feed 1) — stamped by the session-context hook.
  repoKey      String? @map("repo_key")
  branch       String?
  prNumber     Int?    @map("pr_number")
  issueKey     String? @map("issue_key")
  // Hook-stamped git HEAD at session start/end and retained usage counters.
  headShaStart String? @map("head_sha_start")
  headShaEnd   String? @map("head_sha_end")
  skillsUsed   Json    @default("{}") @map("skills_used")

  lastEventNanos BigInt @default(0) @map("last_event_nanos")
  /// Optimistic-lock counter for the log-ingest read-modify-write, incremented on
  /// every write. The watermark cannot be the swap key because zero-timestamp
  /// records do not advance it; two writers could otherwise overwrite JSON maps.
  revision       Int    @default(0)

  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflowRuns WorkflowRun[]

  // Keep both host-agnostic and host-aware lookup keys explicit while native
  // telemetry exporters finish converging on the provider-qualified identity.
  @@unique([workspaceId, sessionId])
  @@unique([workspaceId, provider, sessionId])
  @@index([workspaceId, startedAt])
  @@index([workspaceId, issueKey])
  @@map("agent_sessions")
}

model CaptureEvent {
  id            BigInt   @id @default(autoincrement())
  workspaceId   String   @map("workspace_id") @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  schemaVersion Int      @map("schema_version")
  type          String   @db.VarChar(64)
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz
  host          String   @db.VarChar(32)
  sessionId     String   @map("session_id") @db.VarChar(128)
  runId         String?  @map("run_id") @db.VarChar(32)
  repositoryKey String?  @map("repository_key") @db.VarChar(256)
  taskId        String?  @map("task_id") @db.VarChar(128)
  data          Json     @db.JsonB
  actorId       String   @map("actor_id")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, eventId])
  @@index([receivedAt, id], map: "capture_events_received_at_id_idx")
  @@map("capture_events")
}

model CaptureProvisioning {
  id                       BigInt    @id @default(autoincrement())
  workspaceId              String    @map("workspace_id") @db.Uuid
  actorId                  String    @map("actor_id")
  host                     String    @db.VarChar(32)
  targetKey                String    @map("target_key") @db.VarChar(256)
  repositoryKey            String?   @map("repository_key") @db.VarChar(256)
  state                    String    @db.VarChar(16)
  configuredAt             DateTime? @map("configured_at") @db.Timestamptz
  disabledAt               DateTime? @map("disabled_at") @db.Timestamptz
  reportedAt               DateTime  @map("reported_at") @db.Timestamptz
  pendingCount             Int       @default(0) @map("pending_count")
  errorCode                String?   @map("error_code") @db.VarChar(32)
  attributionPendingCount  Int       @default(0) @map("attribution_pending_count")
  attributionRejectedCount Int       @default(0) @map("attribution_rejected_count")
  attributionLastClaimAt   DateTime? @map("attribution_last_claim_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, actorId, host, targetKey])
  @@map("capture_provisioning")
}

model CaptureAcceptedWatermark {
  workspaceId            String    @map("workspace_id") @db.Uuid
  actorId                String    @map("actor_id")
  host                   String    @db.VarChar(32)
  scopeKey               String    @map("scope_key") @db.VarChar(320)
  repositoryKey          String?   @map("repository_key") @db.VarChar(256)
  firstAcceptedAt        DateTime  @map("first_accepted_at") @db.Timestamptz
  lastAcceptedAt         DateTime  @map("last_accepted_at") @db.Timestamptz
  workflowLastAcceptedAt DateTime? @map("workflow_last_accepted_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([workspaceId, actorId, host, scopeKey])
  @@index([workspaceId, actorId, host, repositoryKey])
  @@map("capture_accepted_watermarks")
}

model CaptureRetentionCheckpoint {
  id                      String   @id @db.VarChar(32)
  purgedThroughReceivedAt DateTime @map("purged_through_received_at") @db.Timestamptz
