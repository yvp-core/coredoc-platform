// HAND-WRITTEN PARTIAL INDEX — NOT REPRESENTABLE IN THIS SCHEMA.
// Migration 20260804000000 creates `push_jobs_one_active_push_per_repo`
// (UNIQUE ON (workspace_id, repo_name) WHERE type='push' AND status IN
// ('pending','running')). The enqueue P2002 race handling in
// push-queue.service.ts depends on it. Prisma cannot express partial indexes,
// so `prisma migrate dev` will diff the schema against the shadow DB and
// propose DROP INDEX — NEVER accept that drop; re-add the index in any
// migration that regenerates this table.
model PushJob {
