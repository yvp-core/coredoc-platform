  normVersion                Int?      @map("norm_version")
  canonicalProjectionVersion Int?      @map("canonical_projection_version")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connector DeliveryConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, connectorId, resourceType, fetchedAt])
  @@index([workspaceId, resourceType, canonicalProjectionVersion, id], map: "delivery_raw_payloads_projection_replay_idx")
  @@map("delivery_raw_payloads")
}

// ── Connector actor identity map and canonical status policy. ──

model DeliveryActor {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  displayName  String?  @map("display_name")
  kind         String   @default("human") // human | agent | bot
  // WorkspaceMember.userId when this actor is a matched workspace member;
  // null = unmatched (surfaced in the admin unmatched-identities queue).
  memberUserId String?  @map("member_user_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace  Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  identities DeliveryActorIdentity[]

  taskExternalRefStateFacts TaskExternalRefStateFact[]

  @@unique([workspaceId, id])
  @@index([workspaceId, memberUserId])
  @@map("delivery_actors")
}

model DeliveryActorIdentity {
  id          BigInt   @id @default(autoincrement())
  workspaceId String   @map("workspace_id") @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  provider    String // jira | github | email | coredoc
  externalId  String   @map("external_id") // accountId / login / lowercased email / userId
  method      String // exact_email | provider_link | manual
  confidence  Float    @default(1.0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     DeliveryActor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, actorId])
  @@map("delivery_actor_identities")
}

model DeliveryStatusMap {
  id                  BigInt   @id @default(autoincrement())
  workspaceId         String   @map("workspace_id") @db.Uuid
  connectorId         String   @map("connector_id") @db.Uuid
  statusRaw           String   @map("status_raw")
  lifecycle           String?  @db.VarChar(16)
  createsShipEvidence Boolean  @default(false) @map("creates_ship_evidence")
  source              String   @default("default") // default (statusCategory bootstrap) | admin
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connector DeliveryConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, connectorId, statusRaw])
  @@map("delivery_status_map")
}

// ===========================================================================
// Cloud product-intent knowledge base (spec: .scratch/intent-cloud-design).
//
// Tenant isolation is PHYSICAL: every child references its parent through a
// composite key carrying `workspaceId`, so a cross-workspace link cannot be
// represented. Parent links use `NoAction` rather than `Restrict` on purpose —
// NO ACTION still refuses to orphan a child, but its check runs at
// end-of-statement, so a workspace hard delete (which cascades parent and child
// in the same statement) still succeeds while a direct domain/feature delete
// with live children still fails at the database.
//
// HAND-WRITTEN CONSTRAINTS AND INDEXES — NOT REPRESENTABLE IN THIS SCHEMA.
// Migration 20260901101000 adds the CHECK constraints (attachment XOR, slug and
// kind-prefix shape, version floor, supersession pairing, transition from<>to)
// and 20260901102000 adds `pg_trgm` plus the GIN trigram indexes
// `intent_items_title_trgm_idx` / `intent_items_statement_trgm_idx`.
// `prisma migrate dev` diffs this file against a shadow database and will
// propose dropping them — NEVER accept that drop; re-add them in any migration
// that regenerates these tables.
// ===========================================================================

// Per-workspace actor that records intent releases (amendment §2).
enum IntentReleaseTrigger {
  manual
  merge
  deploy
}

enum IntentItemKind {
  capability
  use_case
  flow
  business_rule
  limitation
  decision
}

enum IntentItemAuthority {
  candidate
  accepted
  rejected
  superseded
}

enum IntentSourceKind {
  spec
  issue
  adr
  manual
}

/// Authority transitions additionally admit `import`: an import records
/// arrival, it never fabricates a candidate→accepted decision that no reviewer
/// made (spec §4.7).
enum IntentAuthoritySourceKind {
  spec
  issue
  adr
  manual
  import
}

enum IntentAuditEntityKind {
  domain
  feature
  feature_seed
  item
  item_source
  anchor
  dimension
  node_relation
  comment
}

/// A tree node an `IntentNodeRelation` endpoint names: a domain or a feature.
enum IntentNodeKind {
  domain
  feature
}

model IntentDomain {
  workspaceId String   @map("workspace_id") @db.Uuid
  id          String   @db.VarChar(64)
  title       String   @db.VarChar(200)
  statement   String   @db.VarChar(2000)
  /// Tree `appliesWhen` (dimension clauses only); inherited by every item under it.
  appliesWhen Json?    @map("applies_when") @db.JsonB
  /// The node as a document: ordered headings, prose lines and item slots
  /// (`IntentNodeLayoutSchema`). NULL renders items in kind order.
  layout      Json?    @db.JsonB
  /// Hidden from browse defaults; children stay readable. Archiving is the only
  /// way to retire a domain that still holds reviewed content.
  archived    Boolean  @default(false)
  createdBy   String   @map("created_by") @db.VarChar(256)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedBy   String   @map("updated_by") @db.VarChar(256)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  features  IntentFeature[]
  items     IntentItem[]

  @@id([workspaceId, id])
  @@index([workspaceId, archived])
  @@map("intent_domains")
}

/// A workspace-declared context dimension (country, plan, role, …) that item
/// `applies_when` clauses and rule variants reference by id.
model IntentDimension {
  workspaceId String   @map("workspace_id") @db.Uuid
  id          String   @db.VarChar(64)
  title       String   @db.VarChar(200)
  /// `[{id, title}]`, validated by core's `IntentDimensionSchema`. Flat: no hierarchy (LIM-2).
  values      Json     @db.JsonB
  multi       Boolean  @default(false)
  archived    Boolean  @default(false)
  createdBy   String   @map("created_by") @db.VarChar(256)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedBy   String   @map("updated_by") @db.VarChar(256)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([workspaceId, id])
  @@index([workspaceId, archived])
  @@map("intent_dimensions")
}

model IntentFeature {
  workspaceId     String   @map("workspace_id") @db.Uuid
  id              String   @db.VarChar(64)
  domainId        String   @map("domain_id") @db.VarChar(64)
  /// The feature this one sits under, in the same domain (FK enforces it); NULL = top level.
  parentFeatureId String?  @map("parent_feature_id") @db.VarChar(64)
  title           String   @db.VarChar(200)
  statement       String   @db.VarChar(2000)
  appliesWhen     Json?    @map("applies_when") @db.JsonB
  /// See `IntentDomain.layout`.
  layout          Json?    @db.JsonB
  archived        Boolean  @default(false)
  createdBy       String   @map("created_by") @db.VarChar(256)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedBy       String   @map("updated_by") @db.VarChar(256)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  domain    IntentDomain        @relation(fields: [workspaceId, domainId], references: [workspaceId, id], onDelete: NoAction, onUpdate: Cascade)
  parent    IntentFeature?      @relation("IntentFeatureNesting", fields: [workspaceId, parentFeatureId, domainId], references: [workspaceId, id, domainId], onDelete: NoAction, onUpdate: NoAction, map: "intent_features_parent_fkey")
  children  IntentFeature[]     @relation("IntentFeatureNesting")
  seeds     IntentFeatureSeed[]
  items     IntentItem[]
  comments  IntentComment[]

  @@id([workspaceId, id])
  // Reference target for the three-column attachment FK on IntentItem: a
  // feature-attached item must name the feature's OWN domain, so "feature
  // implies its domain" is a foreign key, not a service-layer promise.
  @@unique([workspaceId, id, domainId])
  @@index([workspaceId, domainId])
  @@index([workspaceId, archived])
  @@index([workspaceId, parentFeatureId])
  @@map("intent_features")
}

/// Declared entry points of a feature's code area (spec §4.3). The area itself
/// is derived at read time and never stored.
model IntentFeatureSeed {
  id          BigInt   @id @default(autoincrement())
  workspaceId String   @map("workspace_id") @db.Uuid
  featureId   String   @map("feature_id") @db.VarChar(64)
  repoKey     String   @map("repo_key") @db.VarChar(200)
  nodeId      String   @map("node_id") @db.VarChar(500)
  note        String?  @db.VarChar(2000)
  createdBy   String   @map("created_by") @db.VarChar(256)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  feature IntentFeature @relation(fields: [workspaceId, featureId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workspaceId, featureId, repoKey, nodeId], map: "intent_feature_seeds_identity_key")
  @@index([workspaceId, repoKey, nodeId])
  @@map("intent_feature_seeds")
}

model IntentItem {
  workspaceId           String              @map("workspace_id") @db.Uuid
  id                    String              @db.VarChar(64)
  /// Attachment is exactly one of: product root (both refs null), a domain, or
  /// a feature (which carries its own domain). Enforced by
  /// `intent_items_attachment_check` plus the composite feature FK.
  domainId              String?             @map("domain_id") @db.VarChar(64)
  featureId             String?             @map("feature_id") @db.VarChar(64)
  kind                  IntentItemKind
  title                 String              @db.VarChar(200)
  statement             String              @db.VarChar(2000)
  payload               Json?               @db.JsonB
  /// Context conditions (`ContextCondition[]`, AND-joined); NULL = unconditional.
  appliesWhen           Json?               @map("applies_when") @db.JsonB
  rationale             String?             @db.VarChar(2000)
  /// Markdown lines under the statement (use-case bullets, flow steps, a
  /// diagram), rendered verbatim by the node read. `string[]`; NULL = none.
  body                  Json?               @db.JsonB
  /// Changes only through the review operation; creation always yields
  /// `candidate` (spec §5).
  authority             IntentItemAuthority @default(candidate)
  proposedSuccessorOfId String?             @map("proposed_successor_of_id") @db.VarChar(64)
  supersededById        String?             @map("superseded_by_id") @db.VarChar(64)
  /// Optimistic-concurrency token. Every write is
  /// `UPDATE … WHERE id = ? AND version = ?` and increments it — never
  /// read-then-write.
  version               Int                 @default(1)
  createdBy             String              @map("created_by") @db.VarChar(256)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedBy             String              @map("updated_by") @db.VarChar(256)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  workspace            Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  domain               IntentDomain?               @relation(fields: [workspaceId, domainId], references: [workspaceId, id], onDelete: NoAction, onUpdate: Cascade)
  feature              IntentFeature?              @relation(fields: [workspaceId, featureId, domainId], references: [workspaceId, id, domainId], onDelete: NoAction, onUpdate: Cascade)
  supersededBy         IntentItem?                 @relation("IntentItemSupersession", fields: [workspaceId, supersededById], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  supersedes           IntentItem[]                @relation("IntentItemSupersession")
  proposedSuccessorOf  IntentItem?                 @relation("IntentItemReplacement", fields: [workspaceId, proposedSuccessorOfId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  replacementProposals IntentItem[]                @relation("IntentItemReplacement")
  sources              IntentItemSource[]
  anchors              IntentAnchor[]
  transitions          IntentAuthorityTransition[]
  comments             IntentComment[]

  @@id([workspaceId, id])
  @@index([workspaceId, authority])
  @@index([workspaceId, kind])
  @@index([workspaceId, domainId])
  @@index([workspaceId, featureId])
  @@index([workspaceId, updatedAt])
  @@map("intent_items")
}

enum IntentCommentStatus {
  open
  resolved
}

/// Discussion on a feature or an item. A thread is one root comment, which
/// carries the status, plus its replies (`parentId`), which carry none and name
/// the root's target. Not reviewed intent: never exported, never served to agents.
model IntentComment {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String               @map("workspace_id") @db.Uuid
  /// Exactly one of `featureId` / `itemId` (`intent_comments_target_check`).
  featureId   String?              @map("feature_id") @db.VarChar(64)
  itemId      String?              @map("item_id") @db.VarChar(64)
  parentId    String?              @map("parent_id") @db.Uuid
  body        String               @db.VarChar(2000)
  /// Set on a root, NULL on a reply (`intent_comments_status_check`).
  status      IntentCommentStatus?
  resolvedBy  String?              @map("resolved_by") @db.VarChar(256)
  resolvedAt  DateTime?            @map("resolved_at") @db.Timestamptz
  createdBy   String               @map("created_by") @db.VarChar(256)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  feature   IntentFeature?  @relation(fields: [workspaceId, featureId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade)
  item      IntentItem?     @relation(fields: [workspaceId, itemId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade)
  parent    IntentComment?  @relation("IntentCommentThread", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  replies   IntentComment[] @relation("IntentCommentThread")

  @@index([workspaceId, featureId, createdAt])
  @@index([workspaceId, itemId, createdAt])
  @@index([parentId, createdAt])
  @@map("intent_comments")
}

/// "See also" between two tree nodes, with the reason a reader should follow it.
/// Undirected: stored once with the endpoints in canonical order (see
/// `canonicalRelationEndpoints`). The endpoints are polymorphic, so no FK can
/// name them; deleting a domain or feature deletes its relations in the same
/// transaction instead.
model IntentNodeRelation {
  id          BigInt         @id @default(autoincrement())
  workspaceId String         @map("workspace_id") @db.Uuid
  fromKind    IntentNodeKind @map("from_kind")
  fromId      String         @map("from_id") @db.VarChar(64)
  toKind      IntentNodeKind @map("to_kind")
  toId        String         @map("to_id") @db.VarChar(64)
  why         String         @db.VarChar(500)
  createdBy   String         @map("created_by") @db.VarChar(256)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workspaceId, fromKind, fromId, toKind, toId], map: "intent_node_relations_identity_key")
  @@index([workspaceId, toKind, toId])
  @@map("intent_node_relations")
}

/// Provenance rows rather than embedded JSON, so "items originating from spec
/// X" stays a SQL query (spec §4.5).
model IntentItemSource {
  id          BigInt           @id @default(autoincrement())
  workspaceId String           @map("workspace_id") @db.Uuid
  itemId      String           @map("item_id") @db.VarChar(64)
  kind        IntentSourceKind
  ref         String           @db.VarChar(500)
  localId     String           @map("local_id") @db.VarChar(200)
  revision    String?          @db.VarChar(200)
  locator     String?          @db.VarChar(500)
  /// Human label of the source document, as the capturing agent read it. Not part
  /// of the `(ref, localId)` identity: a re-titled spec is the same source.
  title       String?          @db.VarChar(200)
  /// Where a reader can open the source. Validated by the contract's `externalUrl`
  /// rule (http/https, no credentials) before it ever reaches this column.
  url         String?          @db.VarChar(2048)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  item IntentItem @relation(fields: [workspaceId, itemId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workspaceId, itemId, kind, ref, localId], map: "intent_item_sources_identity_key")
  @@index([workspaceId, kind, ref])
  @@map("intent_item_sources")
}

/// `anchorStatus` (matched/changed/missing) is computed at read time against the
/// current graph snapshot and is deliberately NOT a column here (spec §4.6).
model IntentAnchor {
  id                  BigInt    @id @default(autoincrement())
  workspaceId         String    @map("workspace_id") @db.Uuid
  itemId              String    @map("item_id") @db.VarChar(64)
  repoKey             String    @map("repo_key") @db.VarChar(200)
  nodeId              String    @map("node_id") @db.VarChar(500)
  nodeType            String    @map("node_type") @db.VarChar(64)
  capturedVersionedId String    @map("captured_versioned_id") @db.VarChar(500)
  rationale           String?   @db.VarChar(2000)
  /// `manual` (a maintainer anchored it in a user session) or `ci` (written by
  /// the bindings sync from a PR manifest). The CI sync creates, refreshes and
  /// removes only its OWN rows; a `manual` row of the same identity is left
  /// alone (bindings spec BR-1).
  source              String    @default("manual") @db.VarChar(16)
  disabledAt          DateTime? @map("disabled_at") @db.Timestamptz
  disabledBy          String?   @map("disabled_by") @db.VarChar(256)
  createdBy           String    @map("created_by") @db.VarChar(256)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  item IntentItem @relation(fields: [workspaceId, itemId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workspaceId, itemId, repoKey, nodeId], map: "intent_anchors_identity_key")
  @@index([workspaceId, repoKey, nodeId])
  @@map("intent_anchors")
}

/// Append-only decision history, readable through the API — not just an ops log.
model IntentAuthorityTransition {
  id             BigInt                    @id @default(autoincrement())
  workspaceId    String                    @map("workspace_id") @db.Uuid
  itemId         String                    @map("item_id") @db.VarChar(64)
  /// NULL for import arrivals: an import records that an item arrived already
  /// accepted, it does not fabricate a decision that never happened.
  fromAuthority  IntentItemAuthority?      @map("from_authority")
  toAuthority    IntentItemAuthority       @map("to_authority")
  /// ALWAYS derived from the auth token, never from the request payload.
  actorId        String                    @map("actor_id") @db.VarChar(256)
  actorRole      String                    @map("actor_role") @db.VarChar(32)
  reason         String                    @db.VarChar(2000)
  sourceKind     IntentAuthoritySourceKind @map("source_kind")
  sourceRef      String                    @map("source_ref") @db.VarChar(500)
  sourceLocalId  String?                   @map("source_local_id") @db.VarChar(200)
  sourceRevision String?                   @map("source_revision") @db.VarChar(200)
  workItem       Json?                     @map("work_item") @db.JsonB
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz

  item IntentItem @relation(fields: [workspaceId, itemId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade)

  @@index([workspaceId, itemId, createdAt], map: "intent_authority_transitions_item_recency_idx")
  @@index([workspaceId, createdAt])
  @@map("intent_authority_transitions")
}

/// Workspace-scoped generic trail for tree CRUD and non-authority edits.
/// Authority changes are recorded in IntentAuthorityTransition instead.
model IntentAuditEvent {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String                @map("workspace_id") @db.Uuid
  entityKind  IntentAuditEntityKind @map("entity_kind")
  entityId    String                @map("entity_id") @db.VarChar(200)
  operation   String                @db.VarChar(32)
  actorId     String                @map("actor_id") @db.VarChar(256)
  actorRole   String                @map("actor_role") @db.VarChar(32)
  /// Bounded before/after projections — never a full row dump.
  before      Json?                 @db.JsonB
  after       Json?                 @db.JsonB
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityKind, entityId, createdAt], map: "intent_audit_events_entity_recency_idx")
  @@map("intent_audit_events")
}

/// Idempotency ledger. A replay with the same key AND request hash returns the
/// stored response; the same key with a different hash is an error. Retention
/// window is 30 days, documented with migration 20260901101000; the sweep lands
/// with the mutation-request writer.
model IntentMutationRequest {
  workspaceId    String   @map("workspace_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(200)
  operation      String   @db.VarChar(64)
  requestHash    String   @map("request_hash") @db.Char(64)
  response       Json     @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([workspaceId, idempotencyKey])
  // Global date-only sweep for the retention cron: the workspace-first primary
  // key cannot serve `WHERE created_at < cutoff` across all workspaces.
  @@index([createdAt])
  @@map("intent_mutation_requests")
}

/// Durable effectivity evidence; unlike the mutation replay cache this is never swept.
model IntentReleaseEvent {
  workspaceId    String    @map("workspace_id") @db.Uuid
  seq            Int
  kind           String    @db.VarChar(16)
  idempotencyKey String    @map("idempotency_key") @db.VarChar(200)
  requestHash    String    @map("request_hash") @db.VarChar(64)
  recordedBy     String    @map("recorded_by") @db.VarChar(256)
  recordedAt     DateTime  @default(now()) @map("recorded_at") @db.Timestamptz
  deliveredRef   String?   @map("delivered_ref") @db.VarChar(256)
  reason         String    @db.VarChar(2000)
  data           Json      @db.JsonB
  response       Json      @db.JsonB
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, seq])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, deliveredRef])
  @@map("intent_release_events")
}

// One unfinished operation per reviewed change. JSON stores bounded declarations/results,
// not a second graph or authority store. Both consumers are in IntentHandoffService.
model IntentHandoff {
  id               String    @id @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  repoKey          String    @map("repo_key") @db.VarChar(200)
  version          Int       @default(1)
  headSha          String    @map("head_sha") @db.VarChar(40)
  prNumber         Int?      @map("pr_number")
  payload          Json
  mappingState     String    @default("pending") @map("mapping_state") @db.VarChar(32)
  deliveryState    String    @default("pending") @map("delivery_state") @db.VarChar(32)
  mappingReason    String?   @map("mapping_reason") @db.VarChar(200)
  deliveryReason   String?   @map("delivery_reason") @db.VarChar(200)
  results          Json      @default("[]")
  mergeCommit      String?   @map("merge_commit") @db.VarChar(40)
  prObservedAt     DateTime? @map("pr_observed_at") @db.Timestamptz
  mergedAt         DateTime? @map("merged_at") @db.Timestamptz
  nextAttemptAt    DateTime? @default(now()) @map("next_attempt_at") @db.Timestamptz
  /// Post-merge automatic retries (BR-6); bounded by the processor, reset on a session re-save.
  deliveryAttempts Int       @default(0) @map("delivery_attempts")
  mappingAttempts  Int       @default(0) @map("mapping_attempts")
  /// The deploy that last attempted this delivery: a retry of THAT deploy re-attempts its own failures only.
  deliveryDeployId String?   @map("delivery_deploy_id")
  createdBy        String    @map("created_by")
  updatedBy        String    @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, repoKey, prNumber])
  @@index([nextAttemptAt])
  @@map("intent_handoffs")
}

// ---------------------------------------------------------------------------
// Cloud agent runs: Jira issue to draft pull requests, executed by a
// customer-run agent runner over the runner API. Not the desktop telemetry
// `DesktopAgentRun`. Status and state columns are VarChar with code constants
// (modules/cloud-agent-runs/run-states.ts), so a new value never needs ALTER TYPE.
//
// HAND-WRITTEN PARTIAL INDEXES — NOT REPRESENTABLE IN THIS SCHEMA.
// Migration 20261010120000 creates
//   `cloud_agent_runs_one_open_run_per_issue` (UNIQUE ON (workspace_id,
//   jira_issue_id) WHERE status NOT IN ('done','failed','cancelled')), and
//   `cloud_agent_run_turns_one_pending_turn_per_run` (UNIQUE ON (run_id)
//   WHERE state IN ('queued','claimed')).
// Migration 20261013120000 creates
//   `cloud_agent_run_questions_one_open_per_run` (UNIQUE ON (run_id)
//   WHERE state = 'open').
// Run creation (ACTIVE_RUN_EXISTS), turn queueing and parking a question depend on them. `prisma
// migrate dev` will propose DROP INDEX for both — NEVER accept that drop;
// migration-invariants.test.ts fails if a migration drops them.
// ---------------------------------------------------------------------------

model CloudAgentRun {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId            String    @map("workspace_id") @db.Uuid
  /// The immutable Jira issue id is the identity; the key changes when an issue moves.
  jiraIssueId            String    @map("jira_issue_id") @db.VarChar(64)
  issueKey               String    @map("issue_key") @db.VarChar(64)
  /// Plain column: connectors can be deleted, runs are never-deleted human records.
  jiraConnectorId        String?   @map("jira_connector_id") @db.Uuid
  /// `jira_label`, `manual` or `rerun`.
  trigger                String    @db.VarChar(16)
  startedBy              String?   @map("started_by") @db.VarChar(256)
  previousRunId          String?   @map("previous_run_id") @db.Uuid
  /// The member the run acts as; removal is detected at runtime (`run_owner_removed`).
  runOwnerId             String    @map("run_owner_id") @db.VarChar(256)
  status                 String    @db.VarChar(32)
  phase                  String    @db.VarChar(16)
  failureCode            String?   @map("failure_code") @db.VarChar(64)
  failureReason          String?   @map("failure_reason") @db.VarChar(2000)
  questionsPolicy        String    @map("questions_policy") @db.VarChar(16)
  scopeAcceptancePolicy  String    @map("scope_acceptance_policy") @db.VarChar(16)
  /// Null means Claude Code's default model.
  model                  String?   @db.VarChar(128)
  repositories           Json      @default("[]") @db.JsonB
  seeds                  String[]  @default([])
  droppedSeeds           Json      @default("[]") @map("dropped_seeds") @db.JsonB
  runOrdinal             Int       @map("run_ordinal")
  branch                 String    @db.VarChar(255)
  scopeSessionId         String    @map("scope_session_id") @db.Uuid
  implementSessionId     String    @map("implement_session_id") @db.Uuid
  stateArchiveKey        String?   @map("state_archive_key") @db.VarChar(1024)
  spendUsd               Float     @default(0) @map("spend_usd") @db.DoublePrecision
  agentTurns             Int       @default(0) @map("agent_turns")
  unknownSpendTurns      Int       @default(0) @map("unknown_spend_turns")
  maxSpendUsd            Float     @map("max_spend_usd") @db.DoublePrecision
  maxActiveSeconds       Int       @map("max_active_seconds")
  waitingLimitSeconds    Int       @map("waiting_limit_seconds")
  maxTurnDurationSeconds Int       @map("max_turn_duration_seconds")
  maxRepositories        Int       @map("max_repositories")
  activeSeconds          Int       @default(0) @map("active_seconds")
  activeSince            DateTime? @map("active_since") @db.Timestamptz
  waitingSince           DateTime? @map("waiting_since") @db.Timestamptz
  pullRequests           Json      @default("[]") @map("pull_requests") @db.JsonB
  jiraOutcome            Json      @default("{}") @map("jira_outcome") @db.JsonB
  assumptions            Json      @default("[]") @db.JsonB
  outcomeLessCount       Int       @default(0) @map("outcome_less_count")
  /// The implement phase's adopted `submit_result`: summary, per-repository summaries, notes.
  result                 Json?     @db.JsonB
  /// Last timeline sequence number handed out; the run row serialises numbering.
  lastEventSeq           Int       @default(0) @map("last_event_seq")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  startedAt              DateTime? @map("started_at") @db.Timestamptz
  finishedAt             DateTime? @map("finished_at") @db.Timestamptz
  lastTurnEndedAt        DateTime? @map("last_turn_ended_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace   Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  previousRun CloudAgentRun?             @relation("CloudAgentRunPrevious", fields: [workspaceId, previousRunId], references: [workspaceId, id], onDelete: NoAction, onUpdate: Cascade)
  reruns      CloudAgentRun[]            @relation("CloudAgentRunPrevious")
  turns       CloudAgentRunTurn[]
  events      CloudAgentRunEvent[]
  specs       CloudAgentRunSpecVersion[]
  questions   CloudAgentRunQuestion[]

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, jiraIssueId])
  @@map("cloud_agent_runs")
}

model CloudAgentRunTurn {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  runId            String    @map("run_id") @db.Uuid
  ordinal          Int
  /// `scope`, `implement` or `delivery`.
  kind             String    @db.VarChar(16)
  inputText        String?   @map("input_text") @db.Text
  /// `queued`, `claimed`, `completed` or `abandoned`.
  state            String    @default("queued") @db.VarChar(16)
  attempts         Int       @default(0)
  leaseToken       String?   @map("lease_token") @db.Uuid
  leaseExpiresAt   DateTime? @map("lease_expires_at") @db.Timestamptz
  claimedByTokenId String?   @map("claimed_by_token_id") @db.Uuid
  claimedAt        DateTime? @map("claimed_at") @db.Timestamptz
  outcome          String?   @db.VarChar(32)
  spendUsd         Float?    @map("spend_usd") @db.DoublePrecision
  runnerVersions   Json?     @map("runner_versions") @db.JsonB
  /// The state archive this turn uploaded; becomes the run's archive when the turn completes.
  stateArchiveKey  String?   @map("state_archive_key") @db.VarChar(1024)
  /// This turn's `submit_result`; the completion transaction adopts it.
  result           Json?     @db.JsonB
  /// This turn's `request_repo` under required acceptance (key, reason); completion opens its question.
  repoRequest      Json?     @map("repository_request") @db.JsonB
  /// What the runner reported during this turn, counted against the per-turn report caps.
  reportedEvents     Int     @default(0) @map("reported_events")
  reportedEventBytes Int     @default(0) @map("reported_event_bytes")
  reportedProposals  Int     @default(0) @map("reported_proposals")
  reportedQuestions  Int     @default(0) @map("reported_questions")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt      DateTime? @map("completed_at") @db.Timestamptz

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  run       CloudAgentRun  @relation(fields: [workspaceId, runId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade)
  claimedBy ServiceToken?  @relation("CloudAgentRunTurnClaimedBy", fields: [claimedByTokenId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  mcpTokens ServiceToken[] @relation("ServiceTokenOwningTurn")

  @@unique([workspaceId, id])
  @@unique([runId, ordinal])
  @@index([workspaceId, state, createdAt])
  @@map("cloud_agent_run_turns")
}

model CloudAgentRunEvent {
  id          BigInt   @id @default(autoincrement())
  workspaceId String   @map("workspace_id") @db.Uuid
  runId       String   @map("run_id") @db.Uuid
  turnId      String?  @map("turn_id") @db.Uuid
  seq         Int
  type        String   @db.VarChar(32)
  /// Size-capped at 16 KiB; `truncated` marks a payload that was cut.
  payload     Json     @db.JsonB
  truncated   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  run       CloudAgentRun @relation(fields: [workspaceId, runId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([runId, seq])
  @@map("cloud_agent_run_events")
}

/// A scope proposal. `draft` while its turn runs (hidden from people), then
/// `proposed`, and finally `accepted`, `changes_requested` or `superseded`.
/// A human record: never deleted by retention.
model CloudAgentRunSpecVersion {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  runId        String    @map("run_id") @db.Uuid
  version      Int
  status       String    @db.VarChar(32)
  /// The turn whose `propose_scope` call wrote it; plain column, turns are pruned.
  turnId       String?   @map("turn_id") @db.Uuid
  title        String    @db.VarChar(200)
  summary      String    @db.Text
  /// Size-capped at 256 KiB.
  markdown     String    @db.Text
  /// Repositories (reasons, changes, merge order, eligibility), risks, intent
  /// references, assumptions, dropped seeds and candidates for the PRD.
  content      Json      @db.JsonB
  proposedAt   DateTime  @map("proposed_at") @db.Timestamptz
  reviewedBy   String?   @map("reviewed_by") @db.VarChar(256)
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz
  reviewText   String?   @map("review_text") @db.Text
  autoAccepted Boolean   @default(false) @map("auto_accepted")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  run       CloudAgentRun @relation(fields: [workspaceId, runId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([runId, version])
  @@map("cloud_agent_run_spec_versions")
}

/// A question the agent asked: a clarification in AskUserQuestion's shape
/// (or, later, a repository request). A human record: retention never deletes it.
model CloudAgentRunQuestion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  runId         String    @map("run_id") @db.Uuid
  /// Globally unique; the human API addresses a question by it.
  requestId     String    @unique @default(dbgenerated("gen_random_uuid()")) @map("request_id") @db.Uuid
  /// `clarification` or `repository_request`.
  kind          String    @db.VarChar(32)
  phase         String    @db.VarChar(16)
  /// `open`, `answered`, `auto_answered` or `cancelled`.
  state         String    @db.VarChar(16)
  /// The AskUserQuestion call; the resume turn re-runs it with the answers.
  toolUseId     String?   @map("tool_use_id") @db.VarChar(255)
  /// The repository a `repository_request` question decides; null for clarifications.
  repositoryKey String?   @map("repository_key") @db.VarChar(255)
  questions     Json      @db.JsonB
  /// Per question: the chosen labels and any free text.
  answers       Json?     @db.JsonB
  /// The turn that asked; plain column, turns are pruned.
  askedInTurnId String?   @map("asked_in_turn_id") @db.Uuid
  /// The turn queued to deliver the answer; plain column, turns are pruned.
  resumeTurnId  String?   @map("resume_turn_id") @db.Uuid
  askedAt       DateTime  @map("asked_at") @db.Timestamptz
  answeredAt    DateTime? @map("answered_at") @db.Timestamptz
  /// Null when answered automatically.
  answeredBy    String?   @map("answered_by") @db.VarChar(256)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  run       CloudAgentRun @relation(fields: [workspaceId, runId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade)

  @@index([runId, askedAt])
  @@index([askedInTurnId])
  @@map("cloud_agent_run_questions")
}

/// One per workspace: no workspace settings store exists and the feature has more than ten fields.
model AgentRunSettings {
  workspaceId            String   @id @map("workspace_id") @db.Uuid
  enabled                Boolean  @default(false)
  /// Recorded when agent runs are switched on, or on an explicit takeover; never by other saves.
  runOwnerId             String?  @map("run_owner_id") @db.VarChar(256)
  triggerLabel           String   @default("coredoc-agent") @map("trigger_label") @db.VarChar(255)
  doneStatusId           String?  @map("done_status_id") @db.VarChar(64)
  doneStatusName         String?  @map("done_status_name") @db.VarChar(255)
  questionsPolicy        String   @default("pause") @map("questions_policy") @db.VarChar(16)
  scopeAcceptancePolicy  String   @default("required") @map("scope_acceptance_policy") @db.VarChar(16)
  maxSpendUsd            Float    @default(25) @map("max_spend_usd") @db.DoublePrecision
  maxTurnDurationSeconds Int      @default(10800) @map("max_turn_duration_seconds")
  maxActiveSeconds       Int      @default(86400) @map("max_active_seconds")
  waitingLimitSeconds    Int      @default(604800) @map("waiting_limit_seconds")
  maxStartedRuns         Int      @default(2) @map("max_started_runs")
  maxRepositories        Int      @default(5) @map("max_repositories")
  model                  String?  @db.VarChar(128)
  updatedBy              String?  @map("updated_by") @db.VarChar(256)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("agent_run_settings")
}

/// Last successful claim or heartbeat per runner token. The token's own
/// `last_used_at` is stamped before guards run, so it cannot say this.
model AgentRunnerSeen {
  serviceTokenId  String   @id @map("service_token_id") @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  lastSeenAt      DateTime @map("last_seen_at") @db.Timestamptz
  /// `claim`, `heartbeat` or `startup_check` (a failed start-up check; claims nothing).
  lastAction      String   @map("last_action") @db.VarChar(16)
  protocolVersion Int      @map("protocol_version")
  versions        Json     @db.JsonB
  /// Set when the server refused the runner (an unsupported protocol version) or its start-up check failed.
  refusedReason   String?  @map("refused_reason") @db.VarChar(200)

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  serviceToken ServiceToken @relation(fields: [serviceTokenId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([workspaceId])
  @@map("agent_runner_seen")
}
