  type           PushJobType
  payload        Json
  status         PushJobStatus    @default(pending)
  attempts       Int              @default(0)
  maxAttempts    Int              @default(3) @map("max_attempts")
  lastError      String?          @map("last_error")
  queuedAt       DateTime         @default(now()) @map("queued_at") @db.Timestamptz
  nextRunAt      DateTime         @default(now()) @map("next_run_at") @db.Timestamptz
  startedAt      DateTime?        @map("started_at") @db.Timestamptz
  finishedAt     DateTime?        @map("finished_at") @db.Timestamptz
  result         Json?
  queuedByUserId String?          @map("queued_by_user_id")
  leaseToken     String?          @map("lease_token") @db.Uuid
  heartbeatAt    DateTime?        @map("heartbeat_at") @db.Timestamptz
  phase          String?
  progress       Json?
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  attemptHistory PushJobAttempt[]

  @@index([status, nextRunAt])
  @@index([workspaceId, queuedAt(sort: Desc)])
  @@map("push_jobs")
}

