{
  "$schema": "./schema/coredoc.schema.json",
  "version": "2.0",
  "projects": [
    {
      "id": "example-project",
      "name": "Example Project",
      "repos": [
        {
          "name": "api",
          "path": "./path/to/api",
          "type": "backend"
        }
      ]
    }
  ],
  "output": {
    "dir": "./coredoc-output",
    "format": "json",
    "prettyPrint": true
  },
  "parserStorage": "./coredoc-parsers",
  "agentMode": "interactive",
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/coverage/**"
  ]
}