# Claude Code OAuth Token
CLAUDE_OAUTH_TOKEN=your-oauth-token-here

# Local-only: include raw sourceCode in the local graph so MCP `includeSource`
# can return it. Leave unset for fail-closed — source is stripped before any
# remote push and the server rejects it. Never set this true on a server or when
# pushing to a shared/cloud workspace.
# ALLOW_SOURCES_IN_GRAPH=true

COREDOC_DB_BACKEND=sqlite

# Coredoc-owned Codex runs (desktop authoring/chat/cypher, summarize) are recorded under
# ~/.codex/sessions while this is true (the current default) so external session viewers can
# render them. Set false to make those runs fully ephemeral again. The default is planned to
# flip to false in a future release.
# COREDOC_CODEX_PERSIST_SESSIONS=true

DOTENV_CONFIG_QUIET=true # hide noisy tips logs from dotenv

# Telemetry (baked into cli/mcp/desktop at build; leave blank to disable)
COREDOC_POSTHOG_KEY=
COREDOC_POSTHOG_HOST=https://us.i.posthog.com
# Desktop cloud server URL (optional)
COREDOC_SERVER_URL=
# Desktop cloud web dashboard URL (optional; leave blank to hide the observability dashboard link)
COREDOC_WEB_URL=