{
  "name": "@coredoc/cli",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "description": "CLI for coredoc-platform",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "coredoc": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./parser-remote": {
      "types": "./dist/parser-remote.d.ts",
      "import": "./dist/parser-remote.js"
    }
  },
  "scripts": {
    "gen-build-env": "node ../../scripts/gen-build-env.mjs src/build-env.ts",
    "postinstall": "node -e \"const f='../../scripts/gen-build-env.mjs';require('fs').existsSync(f)&&require('child_process').execFileSync(process.execPath,[f,'src/build-env.ts'],{stdio:'inherit'})\"",
    "build": "node ../../scripts/gen-build-env.mjs src/build-env.ts && tsc",
    "prepack": "pnpm run clean && pnpm run build",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo *.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.55",
    "@ai-sdk/openai": "^4.0.68",
    "@anthropic-ai/claude-agent-sdk": "^0.2.12",
    "@coredoc/core": "workspace:*",
    "@coredoc/db": "workspace:*",
    "@coredoc/mcp": "workspace:*",
    "@coredoc/profile-parser": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "ai": "^7.0.103",
    "commander": "^12.0.0",
    "typescript": ">=5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "yaml": "^2.8.2",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ]
}
