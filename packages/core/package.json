{
  "name": "@coredoc/core",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "Core types and utilities for coredoc-parser",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./utils/project-id": {
      "types": "./dist/utils/project-id.d.ts",
      "import": "./dist/utils/project-id.js"
    },
    "./base-parser": {
      "types": "./dist/base-parser/index.d.ts",
      "import": "./dist/base-parser/index.js"
    },
    "./base-parser/sdk-registry": {
      "types": "./dist/base-parser/sdk-registry.d.ts",
      "import": "./dist/base-parser/sdk-registry.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "import": "./dist/telemetry/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm run clean && pnpm run build",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo *.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "glob": "^13.0.0",
    "posthog-node": "^5.28.11",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": ">=5.0.0",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ]
}
