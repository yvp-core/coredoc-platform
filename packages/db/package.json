{
  "name": "@coredoc/db",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "Database abstraction layer for coredoc (Neo4j + SQLite)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite/index.d.ts",
      "import": "./dist/sqlite/index.js"
    },
    "./neo4j": {
      "types": "./dist/neo4j/index.d.ts",
      "import": "./dist/neo4j/index.js"
    },
    "./ladybug": {
      "types": "./dist/ladybug/index.d.ts",
      "import": "./dist/ladybug/index.js"
    },
    "./file-builder": {
      "types": "./dist/file-builder.d.ts",
      "import": "./dist/file-builder.js"
    },
    "./graph-file": {
      "types": "./dist/graph-file.d.ts",
      "import": "./dist/graph-file.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.contract.json",
    "prepack": "pnpm run clean && pnpm run build",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.contract.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo *.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@coredoc/core": "workspace:*",
    "@ladybugdb/core": "0.19.1",
    "@libsql/client": "^0.14.0"
  },
  "optionalDependencies": {
    "neo4j-driver": "^5.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": ">=5.0.0",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ]
}
