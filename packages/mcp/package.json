{
  "name": "@coredoc/mcp",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "MCP (Model Context Protocol) server for coredoc",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "coredoc-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    }
  },
  "scripts": {
    "gen-build-env": "node ../../scripts/gen-build-env.mjs src/build-env.ts",
    "postinstall": "node -e \"const f='../../scripts/gen-build-env.mjs';require('fs').existsSync(f)&&require('child_process').execFileSync(process.execPath,[f,'src/build-env.ts'],{stdio:'inherit'})\"",
    "build": "node ../../scripts/gen-build-env.mjs src/build-env.ts && tsc",
    "prepack": "pnpm run clean && pnpm run build",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo *.tsbuildinfo",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@coredoc/core": "workspace:*",
    "@coredoc/db": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": ">=5.0.0",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ]
}
