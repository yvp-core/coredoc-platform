{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "coredoc chart values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$",
          "description": "Immutable image digest; when set it overrides tag (repository@digest)."
        },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "publicUrl": {
          "type": "string",
          "pattern": "^https?://.+",
          "description": "Public base URL (required) — drives MCP_SERVER_URL and CORS_ORIGINS."
        },
        "webOrigins": {
          "type": "array",
          "items": { "type": "string", "pattern": "^https?://.+" },
          "description": "Extra public base URLs the UI is served on — drives WEB_ORIGINS. Must be full base URLs, not bare hostnames."
        },
        "replicas": { "type": "integer", "minimum": 1 },
        "env": { "type": "object" },
        "extraEnvFrom": { "type": "array" }
      },
      "required": ["publicUrl"]
    },
    "auth": {
      "type": "object",
      "properties": {
        "upstream": { "enum": ["github", "workos"] },
        "allowedEmailDomains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "existingSecret": { "type": "string" },
        "workos": {
          "type": "object",
          "properties": {
            "authkitDomain": { "type": "string" }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "allowSourcesInGraph": { "type": "boolean" },
        "enableSourceModule": { "type": "boolean" },
        "enableCliBundle": { "type": "boolean" },
        "enableSemanticSearch": { "type": "boolean" }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string" },
        "bucket": { "type": "string" },
        "region": { "type": "string" },
        "existingSecret": { "type": "string" }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "extraHosts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        },
        "annotations": { "type": "object" }
      }
    },
    "migrations": {
      "type": "object",
      "properties": {
        "hook": { "enum": ["helm", "argocd", "manual"] }
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string",
          "description": "Secret with key license.json, mounted read-only at /etc/coredoc/license.json. Empty (default) = no license enforcement."
        }
      }
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "posthogKey": { "type": "string" }
      }
    },
    "agentRunner": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "digest": { "type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$" },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "replicas": { "type": "integer", "minimum": 0 },
        "existingSecret": { "type": "string" },
        "workspaceId": { "type": "string" },
        "apiUrl": { "type": "string", "pattern": "^$|^https?://.+" },
        "githubApiUrl": { "type": "string", "pattern": "^$|^https://.+" },
        "gitAuthor": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "email": { "type": "string" }
          }
        },
        "modelBaseUrl": { "type": "string", "pattern": "^$|^https?://.+" },
        "packageRegistries": {
          "type": "object",
          "description": "Package scope (@name) or \"default\" -> { url, credential? }; credential is \"github\" or \"env:<Secret key>\".",
          "propertyNames": { "pattern": "^(default|@[a-z0-9][a-z0-9._-]*)$" },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "url": { "type": "string", "pattern": "^https?://.+" },
              "credential": { "type": "string", "pattern": "^(github|env:[A-Za-z_][A-Za-z0-9_]*)$" }
            },
            "required": ["url"],
            "additionalProperties": false
          }
        },
        "proxy": {
          "type": "object",
          "properties": {
            "httpsProxy": { "type": "string" },
            "httpProxy": { "type": "string" },
            "noProxy": { "type": "string" }
          }
        },
        "caBundle": {
          "type": "object",
          "properties": {
            "configMap": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "scratch": {
          "type": "object",
          "properties": {
            "sizeLimit": { "type": "string", "minLength": 1 },
            "medium": { "enum": ["", "Memory"] }
          }
        },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "env": { "type": "object" },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "egress": { "type": "array" }
          }
        }
      }
    }
  },
  "required": ["server"],
  "allOf": [
    {
      "description": "The github upstream requires a non-empty login gate — the server refuses to boot with an empty ALLOWED_EMAIL_DOMAINS.",
      "if": {
        "properties": {
          "auth": {
            "properties": {
              "upstream": { "const": "github" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "auth": {
            "properties": {
              "allowedEmailDomains": { "minItems": 1 }
            },
            "required": ["allowedEmailDomains"]
          }
        }
      }
    }
  ]
}
